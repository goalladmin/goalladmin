# 前端镜像：构建平台端产物，交给 nginx 托管并反代 /api 到 server 服务。
# 先只按锁文件下载依赖（pnpm fetch，这一层能缓存，和 apps/ 下有哪几个端无关：删掉不用的端也不用改这里），
# 再拷源码、离线安装、只构建平台端（D-064）。
FROM node:22-alpine AS build
WORKDIR /src
RUN corepack enable
COPY web/pnpm-workspace.yaml web/pnpm-lock.yaml web/package.json web/.npmrc ./
RUN pnpm fetch
COPY web/ .
RUN pnpm install --offline --frozen-lockfile
RUN pnpm --filter @ga/platform build

FROM nginx:1.30-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/platform/dist /usr/share/nginx/html
# 本项目的 LICENSE、NOTICE；第三方许可证清单 third-party-licenses.txt 由构建生成，已在上面的 html 目录里（D-028）
COPY LICENSE NOTICE /licenses/
EXPOSE 80
