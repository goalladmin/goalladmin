# 复制为 deploy/.env 后填写。deploy/.env 不进 git。
# 新部署默认 MySQL 8.4 LTS；已有数据卷升级前先固定已验证的原镜像。
# 数据库引擎升级见 docs/guides/operations.md，不直接切换旧数据卷。
GA_MYSQL_IMAGE=mysql:8.4
GA_DB_ROOT_PASSWORD=
GA_DB_PASSWORD=
# 至少 32 字节，可用: openssl rand -base64 48
GA_JWT_SECRET_PLATFORM=
GA_SERVER_MODE=release
# 浏览器访问前端时的来源（协议 + 域名 + 端口），多个用逗号分隔；刷新和登出接口校验它
GA_SERVER_ALLOWED_ORIGINS=http://localhost:8000
# 前端（nginx）对外端口；改了它要把上面 GA_SERVER_ALLOWED_ORIGINS 里的端口一起改
GA_WEB_PORT=8000
# 后端信任的反向代理地址，默认只信任 compose 里固定 IP 的 nginx 容器；前面还有别的代理时按实际地址填
# GA_SERVER_TRUSTED_PROXIES=172.30.0.10
# 密码哈希算法：argon2id（默认）| bcrypt | pbkdf2-sha256 | pbkdf2-sha512。一般不用改；换了之后已有的密码照常能用。
# 什么时候要改见 docs/guides/password-hash.md
# GA_SERVER_PASSWORD_HASH=argon2id
# 同时做密码计算（登录、解锁、改密、建账号）的上限；0 = 按 CPU 数。用 Argon2id 时内存峰值约为"上限 × 40 MB"
# GA_SERVER_PASSWORD_PARALLEL=0

# 仅 docker-compose.multi.yml 使用；与数据库密码、JWT 密钥分别生成。
# GA_REDIS_PASSWORD=
# 所有实例一致；不同部署使用互不包含的前缀。
# GA_REDIS_KEY_PREFIX=ga:

# 仅 docker-compose.portals.yml 使用：三个端的密钥分别生成，不要复用。
# GA_JWT_SECRET_AGENT=
# GA_JWT_SECRET_MERCHANT=
# GA_PLATFORM_HOST=platform.localhost
# GA_AGENT_HOST=agent.localhost
# GA_MERCHANT_HOST=merchant.localhost
# GA_PORTALS_WEB_PORT=8000
# 来源默认由上面的域名和端口组成；生产经 HTTPS 时分别填写实际来源。
# GA_PLATFORM_ORIGIN=https://platform.example.com
# GA_AGENT_ORIGIN=https://agent.example.com
# GA_MERCHANT_ORIGIN=https://merchant.example.com
# 三端示例中 Redis 默认关闭。要启用，填写三个容器均能访问的同一端点：
# GA_REDIS_ADDR=redis.internal:6379
# GA_REDIS_USERNAME=
# GA_REDIS_DB=0
# GA_REDIS_TLS=true
# 每实例连接池（默认 20/5），数据库总连接预算应累加三个程序及其副本。
# GA_DB_MAX_OPEN_CONNS=20
# GA_DB_MAX_IDLE_CONNS=5

# 自助入驻默认关闭。开启商户入驻时须填写其浏览器来源，release 必须为 HTTPS。
GA_ONBOARDING_AGENT_ENABLED=false
GA_ONBOARDING_MERCHANT_ENABLED=false
GA_ONBOARDING_MERCHANT_ORIGIN=
